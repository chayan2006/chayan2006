# Save as: .github/workflows/profile-3d.yml
# Generates the 3D contribution calendar into ./profile-3d-contrib/
name: GitHub Profile 3D Contrib

on:
  schedule:
    - cron: "0 18 * * *"     # daily, 11:30 PM IST
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: yoshi389111/github-profile-3d-contrib@v0.9.3
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          USERNAME: ${{ github.repository_owner }}

      - name: Commit & push
        run: |
          git config user.name  "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add -A .
          if git commit -m "chore: update 3D contribution graph"; then
            git push
          fi
